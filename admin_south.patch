+# Giọng miền Nam: dặn model + sửa nhẹ các từ miền Bắc lọt vào lời nói (giọng đọc TTS là giọng Nam nên chữ Bắc đọc lên nghe lớ).
+_SOUTH_LINE = ("- Anh nói giọng MIỀN NAM (Sài Gòn) tự nhiên, nhẹ nhàng: dùng 'nha', 'nghen', 'nè', 'á', 'dị', 'hông', 'hen', 'đó', 'vậy'; "
+               "hỏi thì 'hông' thay cho 'không' ở cuối câu ('anh ăn chưa hông?'). TRÁNH từ miền Bắc: 'nhé', 'nhỉ', 'đấy', 'ạ', 'thế', 'ấy', 'à ơi'. "
+               "Đừng cố nhồi từ địa phương, chỉ cần tự nhiên như người Sài Gòn nói chuyện.")
+
+_SOUTH_SUBS = [
+    (re.compile(r"\bnhé\b", re.I), "nha"),
+    (re.compile(r"\bnhỉ\b", re.I), "hen"),
+    (re.compile(r"\bđấy\b", re.I), "đó"),
+    (re.compile(r"\bthế\b(?!\s+(?:giới|nào|hệ|kỷ|giờ))", re.I), "vậy"),
+    (re.compile(r"\bkhông(?=\s*[?？]\s*$)", re.I), "hông"),       # chỉ 'không?' cuối câu hỏi
+    (re.compile(r"\bkhông(?=\s*[?？][\"”']?\s)", re.I), "hông"),   # 'không?' giữa các câu
+]
+
+
+def southernize(text: str) -> str:
+    """Đổi các từ miền Bắc hay lọt vào sang miền Nam, giữ nguyên hoa/thường chữ đầu."""
+    def keep_case(m, rep):
+        w = m.group(0)
+        return rep.capitalize() if w[:1].isupper() else rep
+    out = text or ""
+    for rx, rep in _SOUTH_SUBS:
+        out = rx.sub(lambda m, r=rep: keep_case(m, r), out)
+    return out
+
