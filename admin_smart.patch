+def collapse_repeat(text: str) -> str:
+    """Model nhỏ đôi khi nói lặp nguyên câu ('A, B. A, B.'): giữ một lần."""
+    t = (text or "").strip()
+    n = len(t)
+    for k in (2, 3, 4):
+        if n >= 20 and n % k == 0:
+            part = t[: n // k]
+            if part * k == t:
+                return part.strip()
+    sents = [x.strip() for x in re.split(r"(?<=[.!?…])\s+", t) if x.strip()]
+    out = []
+    for x in sents:
+        if not out or x.lower() != out[-1].lower():
+            out.append(x)
+    half = len(t) // 2
+    a, b = t[:half].strip(), t[half:].strip()
+    if len(a) > 15 and a.rstrip(" .,!?…").lower() == b.rstrip(" .,!?…").lower():
+        return a
+    return " ".join(out)
+
