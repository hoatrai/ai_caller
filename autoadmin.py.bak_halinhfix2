def southernize(text: str) -> str:
    """Đổi các từ miền Bắc hay lọt vào sang miền Nam, giữ nguyên hoa/thường chữ đầu."""
    def keep_case(m, rep):
        w = m.group(0)
        return rep.capitalize() if w[:1].isupper() else rep
    out = text or ""
    for rx, rep in _SOUTH_SUBS:
        out = rx.sub(lambda m, r=rep: keep_case(m, r), out)
    return out


