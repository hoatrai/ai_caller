def _hanh_arc(extra: str) -> str:
    if _hanh_is_gentle(extra):
        return ("- HƯỚNG CỦA ANH trong cuộc gọi này: anh cũng sốc và sợ, nhưng chọn ở lại với em. Anh thương em thật nên lúc đầu cũng hoảng, "
