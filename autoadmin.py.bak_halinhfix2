def _admin_turn_shape_default(history: list, turns: int = 0, rng=random) -> tuple[int, str]:
    """Bốc kiểu lượt cho admin ảo. history = các kiểu đã dùng (cũ -> mới); kiểu vừa dùng bị giảm xác suất, không để 3 lượt liền một kiểu.
    Trả (chỉ số kiểu, dòng chỉ dẫn gắn cuối prompt)."""
    idx, w = [], []
    for i, (wt, min_turn, _) in enumerate(_ADMIN_SHAPES):
        if turns < min_turn:
            continue
        if len(history) >= 2 and history[-1] == history[-2] == i:
            continue
        idx.append(i)
        w.append(wt * (0.25 if history and history[-1] == i else 1.0))
    i = rng.choices(idx, weights=w)[0]
    return i, "KIỂU LỜI NÓI LƯỢT NÀY (bắt buộc làm đúng, ghi đè quy định độ dài ở trên): " + _ADMIN_SHAPES[i][2]


