# ===== LLM + STT MIỄN PHÍ (chọn 1 trong 2, hoặc cả hai để dự phòng) =====
# Groq free tier: https://console.groq.com/keys  (LLM llama-3.3-70b + Whisper STT, đều free)
GROQ_API_KEY=
# Google Gemini free tier (dự phòng LLM): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# ===== TTS FPT.AI (tuỳ chọn — chỉ cần khi đặt "tts": {"provider": "fpt"} trong config.json) =====
# Lấy key ở https://console.fpt.ai — gói free 100.000 ký tự/tháng, hết thì mua gói; lỗi/hết hạn mức sẽ tự dùng edge-tts
FPT_API_KEY=
